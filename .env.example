# Copy to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=

# Qdrant Cloud endpoint, e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_HOST=
QDRANT_API_KEY=

# Shared password: the Streamlit UI prompts users for this and forwards it on
# every backend request; the API rejects requests where it doesn't match.
APP_PASSWORD=

# Optional: LangSmith tracing for the LangChain/LangGraph agent runs. Leave unset to
# disable tracing entirely - these aren't read via Settings, just picked up from the
# environment by the langsmith SDK itself.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
