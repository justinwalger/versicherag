# Copy to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=

# Qdrant Cloud endpoint, e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_HOST=
QDRANT_API_KEY=

# Shared password: the Streamlit UI prompts users for this and forwards it on
# every backend request; the API rejects requests where it doesn't match.
APP_PASSWORD=

# Optional: Langfuse tracing for LangChain/LangGraph agent runs. The API key pair
# belongs to the Langfuse project selected when the keys were created; there is
# no separate LANGFUSE_PROJECT variable.
LANGFUSE_TRACING=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
